#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Root"
{
    def Xform "At"
    {
        double3 xformOp:translate = (0, 5, 0)
        float3 xformOp:scale = (1, 2, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        def Sphere "Ball"
        {
            double radius = 1
            color3f[] primvars:displayColor = [(1, 0, 0)]
        }
    }
}
