#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Scope "Root"
{
    def Material "Mat"
    {
        token outputs:surface.connect = </Root/Mat/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 0, 0)
            token outputs:surface
        }
    }
}
